<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CarryAura | Bags & Lifestyle</title>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet"
    >

    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
        }
    </style>
</head>


<body class="bg-[#f7f5f0] text-[#26352f]">


    <!-- NAVBAR -->

    <nav class="w-full bg-[#f7f5f0] border-b border-[#ddd8ce]">

        <div class="max-w-7xl mx-auto px-6 md:px-10 py-5 flex items-center justify-between">

            <!-- LOGO -->

            <a href="/" class="flex items-center gap-3">

                <div
                    class="w-11 h-11 rounded-full bg-[#285c4d] text-white flex items-center justify-center"
                >
                    <i class="ri-shopping-bag-3-line text-xl"></i>
                </div>

                <div>
                    <h1 class="text-xl font-bold tracking-wide">
                        CarryAura
                    </h1>

                    <p class="text-[9px] tracking-[4px] text-gray-500 uppercase">
                        Bags & Lifestyle
                    </p>
                </div>

            </a>


            <!-- NAV LINKS -->

            <div class="hidden md:flex items-center gap-8 text-sm">

                <a
                    href="/"
                    class="hover:text-[#285c4d] transition"
                >
                    Home
                </a>

                <a
                    href="/shop"
                    class="hover:text-[#285c4d] transition"
                >
                    Shop
                </a>

                <a
                    href="/users/login"
                    class="hover:text-[#285c4d] transition"
                >
                    Login
                </a>

                <a
                    href="/users/register"
                    class="px-5 py-2.5 rounded-full bg-[#285c4d] text-white hover:bg-[#1d493d] transition"
                >
                    Create Account
                </a>

            </div>


            <!-- MOBILE ICON -->

            <a
                href="/shop"
                class="md:hidden w-10 h-10 rounded-full bg-[#285c4d] text-white flex items-center justify-center"
            >
                <i class="ri-shopping-bag-line"></i>
            </a>

        </div>

    </nav>



    <!-- HERO SECTION -->

    <section class="max-w-7xl mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-16">

        <div class="grid md:grid-cols-2 gap-10 items-center">


            <!-- LEFT -->

            <div class="max-w-xl">

                <p
                    class="text-sm uppercase tracking-[4px] text-[#285c4d] font-semibold mb-5"
                >
                    Everyday bags. Made better.
                </p>


                <h2
                    class="text-5xl md:text-7xl leading-[0.95] font-semibold tracking-tight text-[#26352f]"
                >
                    Carry what
                    <span class="text-[#6d9b8c]">
                        matters.
                    </span>
                </h2>


                <p
                    class="mt-7 text-gray-600 text-base md:text-lg leading-8 max-w-lg"
                >
                    Discover practical, stylish bags designed for everyday
                    adventures. From work and travel to weekends away,
                    find something that fits your life.
                </p>


                <!-- BUTTONS -->

                <div class="flex flex-wrap gap-4 mt-8">

                    <a
                        href="/shop"
                        class="px-7 py-3.5 rounded-full bg-[#285c4d] text-white font-medium hover:bg-[#1d493d] transition flex items-center gap-2"
                    >
                        Explore Collection
                        <i class="ri-arrow-right-line"></i>
                    </a>

                    <a
                        href="/users/register"
                        class="px-7 py-3.5 rounded-full border border-[#285c4d] text-[#285c4d] font-medium hover:bg-[#285c4d] hover:text-white transition"
                    >
                        Join Us
                    </a>

                </div>


                <!-- SMALL INFO -->

                <div class="flex items-center gap-8 mt-10 pt-7 border-t border-[#ddd8ce]">

                    <div>
                        <h3 class="font-bold text-lg">
                            100%
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Everyday ready
                        </p>
                    </div>

                    <div class="h-8 w-px bg-[#d5d0c6]"></div>

                    <div>
                        <h3 class="font-bold text-lg">
                            24/7
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Shop online
                        </p>
                    </div>

                    <div class="h-8 w-px bg-[#d5d0c6]"></div>

                    <div>
                        <h3 class="font-bold text-lg">
                            Easy
                        </h3>

                        <p class="text-xs text-gray-500 mt-1">
                            Simple shopping
                        </p>
                    </div>

                </div>

            </div>



            <!-- RIGHT HERO IMAGE -->

            <div class="relative">

                <!-- Decorative background -->

                <div
                    class="absolute -top-5 -right-5 w-32 h-32 rounded-full bg-[#dce9e2]"
                ></div>

                <div
                    class="absolute -bottom-5 -left-5 w-24 h-24 rounded-full bg-[#e8d6c7]"
                ></div>


                <!-- Image card -->

                <div
                    class="relative bg-[#ead8ca] rounded-[2rem] overflow-hidden min-h-[460px] flex items-center justify-center"
                >

                    <img
                        src="/images/1bag.png"
                        alt="CarryAura bag"
                        class="w-[85%] max-h-[440px] object-contain hover:scale-105 transition duration-500"
                    >

                    <!-- Floating label -->

                    <div
                        class="absolute bottom-6 left-6 right-6 bg-white/90 backdrop-blur-sm rounded-2xl px-5 py-4 flex items-center justify-between"
                    >

                        <div>

                            <p class="text-xs uppercase tracking-widest text-gray-500">
                                Featured
                            </p>

                            <h3 class="font-semibold text-lg">
                                Everyday Collection
                            </h3>

                        </div>

                        <a
                            href="/shop"
                            class="w-10 h-10 rounded-full bg-[#285c4d] text-white flex items-center justify-center hover:scale-105 transition"
                        >
                            <i class="ri-arrow-right-up-line"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- CATEGORY STRIP -->

    <section class="bg-[#285c4d] text-white">

        <div class="max-w-7xl mx-auto px-6 md:px-10 py-10">

            <div class="grid grid-cols-2 md:grid-cols-4 gap-8">


                <a
                    href="/shop"
                    class="group"
                >

                    <div class="flex items-center gap-4">

                        <div
                            class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-[#285c4d] transition"
                        >
                            <i class="ri-briefcase-4-line text-xl"></i>
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Work Bags
                            </h3>

                            <p class="text-xs text-white/60 mt-1">
                                Smart & practical
                            </p>
                        </div>

                    </div>

                </a>


                <a
                    href="/shop"
                    class="group"
                >

                    <div class="flex items-center gap-4">

                        <div
                            class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-[#285c4d] transition"
                        >
                            <i class="ri-backpack-line text-xl"></i>
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Backpacks
                            </h3>

                            <p class="text-xs text-white/60 mt-1">
                                Built for daily life
                            </p>
                        </div>

                    </div>

                </a>


                <a
                    href="/shop"
                    class="group"
                >

                    <div class="flex items-center gap-4">

                        <div
                            class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-[#285c4d] transition"
                        >
                            <i class="ri-suitcase-2-line text-xl"></i>
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                Travel Bags
                            </h3>

                            <p class="text-xs text-white/60 mt-1">
                                Ready to go
                            </p>
                        </div>

                    </div>

                </a>


                <a
                    href="/shop"
                    class="group"
                >

                    <div class="flex items-center gap-4">

                        <div
                            class="w-12 h-12 rounded-full bg-white/10 flex items-center justify-center group-hover:bg-white group-hover:text-[#285c4d] transition"
                        >
                            <i class="ri-shopping-bag-2-line text-xl"></i>
                        </div>

                        <div>
                            <h3 class="font-semibold">
                                All Bags
                            </h3>

                            <p class="text-xs text-white/60 mt-1">
                                Explore everything
                            </p>
                        </div>

                    </div>

                </a>

            </div>

        </div>

    </section>



    <!-- WHY CARRYAURA -->

    <section class="max-w-7xl mx-auto px-6 md:px-10 py-20">

        <div class="text-center max-w-2xl mx-auto">

            <p
                class="text-xs uppercase tracking-[4px] text-[#6d9b8c] font-semibold"
            >
                Why CarryAura
            </p>

            <h2 class="text-3xl md:text-4xl font-semibold mt-3">
                Designed for real life
            </h2>

            <p class="text-gray-600 mt-4 leading-7">
                Bags should look good, feel comfortable and keep up with
                wherever your day takes you.
            </p>

        </div>


        <div class="grid md:grid-cols-3 gap-6 mt-12">


            <!-- CARD 1 -->

            <div
                class="bg-white rounded-3xl p-8 border border-[#e4e0d8] hover:-translate-y-1 transition"
            >

                <div
                    class="w-12 h-12 rounded-2xl bg-[#e2eee8] text-[#285c4d] flex items-center justify-center"
                >
                    <i class="ri-heart-3-line text-xl"></i>
                </div>

                <h3 class="font-semibold text-xl mt-6">
                    Made for everyday
                </h3>

                <p class="text-gray-500 leading-7 mt-3">
                    Comfortable designs that work just as well on busy
                    weekdays as they do on relaxed weekends.
                </p>

            </div>


            <!-- CARD 2 -->

            <div
                class="bg-[#ead8ca] rounded-3xl p-8 hover:-translate-y-1 transition"
            >

                <div
                    class="w-12 h-12 rounded-2xl bg-white/70 text-[#8a5a42] flex items-center justify-center"
                >
                    <i class="ri-palette-line text-xl"></i>
                </div>

                <h3 class="font-semibold text-xl mt-6">
                    Style that lasts
                </h3>

                <p class="text-gray-600 leading-7 mt-3">
                    Simple colours and timeless shapes that fit naturally
                    into your wardrobe.
                </p>

            </div>


            <!-- CARD 3 -->

            <div
                class="bg-[#dce9e2] rounded-3xl p-8 hover:-translate-y-1 transition"
            >

                <div
                    class="w-12 h-12 rounded-2xl bg-white/70 text-[#285c4d] flex items-center justify-center"
                >
                    <i class="ri-shield-check-line text-xl"></i>
                </div>

                <h3 class="font-semibold text-xl mt-6">
                    Simple shopping
                </h3>

                <p class="text-gray-600 leading-7 mt-3">
                    Browse the collection, create your account and keep
                    your favourite products together in your cart.
                </p>

            </div>

        </div>

    </section>



    <!-- SHOP CTA -->

    <section class="max-w-7xl mx-auto px-6 md:px-10 pb-20">

        <div
            class="rounded-[2rem] bg-[#1f4037] text-white overflow-hidden relative"
        >

            <div class="grid md:grid-cols-2 items-center">

                <div class="p-8 md:p-14">

                    <p
                        class="text-xs uppercase tracking-[4px] text-[#b7d7ca]"
                    >
                        Your next favourite bag
                    </p>

                    <h2 class="text-3xl md:text-5xl font-semibold mt-4 leading-tight">
                        Find something worth carrying.
                    </h2>

                    <p class="text-white/70 mt-5 leading-7 max-w-lg">
                        Take a look through our collection and discover a
                        bag that fits your everyday style.
                    </p>

                    <a
                        href="/shop"
                        class="inline-flex items-center gap-2 mt-7 px-7 py-3.5 bg-white text-[#1f4037] rounded-full font-semibold hover:bg-[#e7eee9] transition"
                    >
                        Shop the collection
                        <i class="ri-arrow-right-line"></i>
                    </a>

                </div>


                <div
                    class="h-72 md:h-full min-h-[330px] bg-[#d8c5b5] flex items-center justify-center"
                >

                    <img
                        src="/images/2bag.png"
                        alt="CarryAura collection"
                        class="h-[90%] max-w-[85%] object-contain hover:scale-105 transition duration-500"
                    >

                </div>

            </div>

        </div>

    </section>



    <!-- FOOTER -->

    <footer class="border-t border-[#ddd8ce] bg-[#f7f5f0]">

        <div
            class="max-w-7xl mx-auto px-6 md:px-10 py-8 flex flex-col md:flex-row items-center justify-between gap-4"
        >

            <div>

                <h3 class="font-bold">
                    CarryAura
                </h3>

                <p class="text-xs text-gray-500 mt-1">
                    Bags for wherever life takes you.
                </p>

            </div>


            <div class="flex items-center gap-6 text-sm">

                <a
                    href="/shop"
                    class="hover:text-[#285c4d] transition"
                >
                    Shop
                </a>

                <a
                    href="/users/login"
                    class="hover:text-[#285c4d] transition"
                >
                    Login
                </a>

                <a
                    href="/users/register"
                    class="hover:text-[#285c4d] transition"
                >
                    Create Account
                </a>

            </div>


            <p class="text-xs text-gray-400">
                © <%= new Date().getFullYear() %> CarryAura
            </p>

        </div>

    </footer>


</body>

</html>