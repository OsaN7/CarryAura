<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Login | CarryAura Bags</title>

    <link
        href="https://cdn.jsdelivr.net/npm/remixicon@4.2.0/fonts/remixicon.css"
        rel="stylesheet"
    />

    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-[#f5eee7] text-[#2b211c]">

    <!-- NAVBAR -->

    <nav class="w-full px-8 md:px-14 py-6 flex items-center justify-between">

        <a href="/" class="text-2xl font-semibold tracking-wide">
            CarryAura
        </a>

        <div class="flex items-center gap-6 text-sm">

            <a
                href="/shop"
                class="hover:opacity-60 transition"
            >
                Shop
            </a>

            <a
                href="/users/register"
                class="px-5 py-2 rounded-full border border-[#2b211c] hover:bg-[#2b211c] hover:text-white transition"
            >
                Create Account
            </a>

        </div>

    </nav>


    <!-- MAIN -->

    <main class="min-h-[calc(100vh-100px)] px-6 md:px-14 py-10 flex items-center justify-center">

        <div
            class="w-full max-w-6xl grid md:grid-cols-2 overflow-hidden rounded-[30px] shadow-xl bg-white"
        >

            <!-- LEFT SIDE -->

            <div
                class="hidden md:flex relative min-h-[650px] bg-[#ead5c5] p-12 flex-col justify-between overflow-hidden"
            >

                <div class="relative z-10">

                    <p class="text-sm uppercase tracking-[0.3em] mb-5">
                        Everyday Carry
                    </p>

                    <h1 class="text-5xl lg:text-6xl font-semibold leading-tight">
                        Carry your
                        <br>
                        <span class="italic">style.</span>
                    </h1>

                    <p class="mt-6 max-w-sm text-[#5d4a3d] leading-relaxed">
                        Discover bags designed for everyday adventures,
                        work, travel and everything in between.
                    </p>

                </div>


                <!-- Decorative bags -->

                <div class="absolute -bottom-20 -right-20 w-96 h-96 rounded-full bg-[#d5b39b]"></div>

                <div class="absolute bottom-12 right-12 w-52 h-52 rounded-full bg-[#c69b7b] opacity-70"></div>


                <div class="relative z-10">

                    <div class="flex items-center gap-3">

                        <div class="w-10 h-10 rounded-full bg-[#2b211c] text-white flex items-center justify-center">
                            <i class="ri-shopping-bag-3-line"></i>
                        </div>

                        <div>
                            <p class="font-semibold">
                                Premium Bags
                            </p>

                            <p class="text-xs text-[#6b5648]">
                                Built for your everyday
                            </p>
                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE / LOGIN -->

            <div class="p-8 md:p-12 lg:p-16 flex items-center">

                <div class="w-full max-w-md mx-auto">

                    <!-- Heading -->

                    <div class="mb-8">

                        <p class="text-sm uppercase tracking-[0.2em] text-[#9b745b] mb-3">
                            Welcome Back
                        </p>

                        <h2 class="text-4xl font-semibold">
                            Login
                        </h2>

                        <p class="mt-3 text-gray-500">
                            Login to continue shopping your favorite bags.
                        </p>

                    </div>


                    <!-- ERROR MESSAGE -->

                    <% if (typeof error !== "undefined" && error.length > 0) { %>

                        <div class="mb-5 rounded-xl bg-red-50 border border-red-200 px-4 py-3 text-sm text-red-600">

                            <%= error %>

                        </div>

                    <% } %>


                    <!-- LOGIN FORM -->

                    <form
                        action="/users/login"
                        method="POST"
                        class="space-y-5"
                    >

                        <!-- EMAIL -->

                        <div>

                            <label
                                for="email"
                                class="block text-sm font-medium mb-2"
                            >
                                Email
                            </label>

                            <div class="relative">

                                <i
                                    class="ri-mail-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
                                ></i>

                                <input
                                    id="email"
                                    name="email"
                                    type="email"
                                    placeholder="Enter your email"
                                    required
                                    autocomplete="email"
                                    class="w-full rounded-xl border border-gray-200 bg-gray-50 py-3.5 pl-11 pr-4 outline-none focus:border-[#9b745b] focus:ring-2 focus:ring-[#ead5c5] transition"
                                >

                            </div>

                        </div>


                        <!-- PASSWORD -->

                        <div>

                            <label
                                for="password"
                                class="block text-sm font-medium mb-2"
                            >
                                Password
                            </label>

                            <div class="relative">

                                <i
                                    class="ri-lock-line absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"
                                ></i>

                                <input
                                    id="password"
                                    name="password"
                                    type="password"
                                    placeholder="Enter your password"
                                    required
                                    autocomplete="current-password"
                                    class="w-full rounded-xl border border-gray-200 bg-gray-50 py-3.5 pl-11 pr-4 outline-none focus:border-[#9b745b] focus:ring-2 focus:ring-[#ead5c5] transition"
                                >

                            </div>

                        </div>


                        <!-- LOGIN BUTTON -->

                        <button
                            type="submit"
                            class="w-full rounded-xl bg-[#2b211c] text-white py-3.5 font-medium hover:bg-[#4a372c] transition flex items-center justify-center gap-2"
                        >

                            Login

                            <i class="ri-arrow-right-line"></i>

                        </button>

                    </form>


                    <!-- REGISTER -->

                    <div class="mt-8 pt-6 border-t border-gray-100 text-center">

                        <p class="text-gray-500 text-sm">
                            Don't have an account?
                        </p>

                        <a
                            href="/users/register"
                            class="inline-flex items-center gap-1 mt-2 font-medium text-[#9b745b] hover:text-[#2b211c] transition"
                        >

                            Create an account

                            <i class="ri-arrow-right-line"></i>

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </main>

</body>

</html>