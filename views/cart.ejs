<%- include('./partials/header') %>

<div class="w-full min-h-screen flex items-start px-20 py-20 gap-10">

    <%
        /*
         * GROUP DUPLICATE PRODUCTS
         *
         * Example:
         *
         * user.cart =
         * [Bag, Bag, Shoes]
         *
         * becomes:
         *
         * [
         *   { product: Bag, quantity: 2 },
         *   { product: Shoes, quantity: 1 }
         * ]
         */

        const cartItems = [];

        user.cart.forEach(function(product) {

            const existingProduct = cartItems.find(function(item) {

                return item.product._id.toString() === product._id.toString();

            });

            if (existingProduct) {

                existingProduct.quantity += 1;

            } else {

                cartItems.push({
                    product: product,
                    quantity: 1
                });

            }

        });


        /*
         * PRICE CALCULATIONS
         */

        const totalMRP = user.cart.reduce(function(total, product) {

            return total + Number(product.price);

        }, 0);


        const discount = totalMRP * 0.10;


        const platformFee = 20;


        const totalAmount = totalMRP - discount + platformFee;

    %>


    <!-- ============================== -->
    <!-- CART PRODUCTS -->
    <!-- ============================== -->

    <div class="w-[30%] rounded-md overflow-hidden">

        <% if (cartItems.length > 0) { %>


            <% cartItems.forEach(function(item) { %>

                <%
                    const product = item.product;
                    const quantity = item.quantity;

                    const productTotal =
                        Number(product.price) * quantity;
                %>


                <!-- PRODUCT IMAGE -->

                <div
                    class="w-full flex justify-center items-center h-80"
                    style="background-color: <%= product.bgcolor %>;"
                >

                    <img
                        class="h-[18rem] w-full object-cover"
                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                        alt="<%= product.name %>"
                    >

                </div>


                <!-- PRODUCT DETAILS -->

                <div
                    class="w-full flex justify-between px-5 py-4"
                    style="
                        background-color: <%= product.panelcolor %>;
                        color: <%= product.textcolor %>;
                    "
                >

                    <h3 class="text-2xl">
                        <%= product.name %>
                    </h3>


                    <!-- QUANTITY -->

                    <div class="flex items-center gap-2">


                        <!-- PLUS -->

                        <form
                            action="/cart/add/<%= product._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="w-7 h-7 bg-white text-black flex rounded-full items-center justify-center"
                            >

                                <i class="ri-add-line"></i>

                            </button>

                        </form>


                        <!-- QUANTITY NUMBER -->

                        <div
                            class="px-2 py-1 rounded-md bg-white text-black"
                        >

                            <%= quantity %>

                        </div>


                        <!-- MINUS -->

                        <form
                            action="/cart/remove/<%= product._id %>"
                            method="POST"
                        >

                            <button
                                type="submit"
                                class="w-7 h-7 bg-white text-black flex rounded-full items-center justify-center"
                            >

                                <i class="ri-subtract-line"></i>

                            </button>

                        </form>

                    </div>

                </div>


                <!-- NET TOTAL -->

                <div
                    class="flex items-center justify-between px-5 py-3 bg-[#999]"
                >

                    <h4 class="text-lg">
                        Net Total
                    </h4>

                    <h2 class="text-lg">

                        ₹ <%= productTotal.toFixed(2) %>

                    </h2>

                </div>


            <% }) %>


        <% } else { %>


            <!-- EMPTY CART -->

            <div class="p-5 bg-zinc-100 rounded-md">

                <h2 class="text-xl">
                    Your cart is empty.
                </h2>

                <a
                    href="/shop"
                    class="inline-block mt-3 text-blue-500"
                >
                    Go to Shop
                </a>

            </div>


        <% } %>

    </div>


    <!-- ============================== -->
    <!-- PRICE BREAKDOWN -->
    <!-- ============================== -->

    <div class="w-[70%]">

        <h3 class="text-xl">
            Price Breakdown
        </h3>


        <div class="px-10 mt-5">


            <!-- TOTAL MRP -->

            <div class="flex mt-2">

                <h4 class="w-1/3">
                    Total MRP
                </h4>

                <h4>
                    ₹ <%= totalMRP.toFixed(2) %>
                </h4>

            </div>


            <!-- DISCOUNT -->

            <div class="flex mt-2">

                <h4 class="w-1/3">
                    Discount on MRP
                </h4>

                <h4>
                    ₹ <%= discount.toFixed(2) %>
                </h4>

            </div>


            <!-- PLATFORM FEE -->

            <div class="flex mt-2">

                <h4 class="w-1/3">
                    Platform Fee
                </h4>

                <h4>
                    ₹ <%= platformFee.toFixed(2) %>
                </h4>

            </div>


            <!-- SHIPPING -->

            <div class="flex mt-2">

                <h4 class="w-1/3">
                    Shipping Fee
                </h4>

                <h4>
                    FREE
                </h4>

            </div>

        </div>


        <!-- LINE -->

        <div class="w-full h-[1px] bg-black mt-10"></div>


        <!-- TOTAL -->

        <div class="flex mt-5">

            <h3 class="w-1/3 text-xl">
                Total Amount
            </h3>

            <h3 class="font-semibold text-xl text-green-600">

                ₹ <%= totalAmount.toFixed(2) %>

            </h3>

        </div>

    </div>

</div>

<%- include('./partials/footer') %>