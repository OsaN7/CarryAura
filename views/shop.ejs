<%- include('./partials/header') %>

<!-- ========================= -->
<!-- SHOP PAGE -->
<!-- ========================= -->

<div class="min-h-screen bg-[#faf9f7]">

    <!-- HERO SECTION -->

    <section class="px-10 pt-12 pb-8">

        <div
            class="relative overflow-hidden rounded-3xl px-10 py-14 bg-gradient-to-r from-[#30221c] via-[#5b4032] to-[#9a6b4f]"
        >

            <!-- Decorative circles -->

            <div
                class="absolute -right-20 -top-20 w-72 h-72 rounded-full bg-white/10"
            ></div>

            <div
                class="absolute right-20 bottom-[-100px] w-64 h-64 rounded-full bg-[#d8a47f]/20"
            ></div>


            <div class="relative z-10 max-w-2xl">

                <p
                    class="text-[#e8c7ad] uppercase tracking-[0.3em] text-sm mb-4"
                >
                    Premium Bags Collection
                </p>

                <h1
                    class="text-5xl md:text-6xl font-semibold text-white leading-tight"
                >
                    Carry your style.
                    <span class="text-[#e5b995]">
                        Everywhere.
                    </span>
                </h1>

                <p class="text-white/75 mt-5 text-lg max-w-xl">
                    Discover stylish backpacks, travel bags, totes and
                    everyday essentials designed for every journey.
                </p>

                <a
                    href="#products"
                    class="inline-flex mt-7 px-6 py-3 rounded-full bg-white text-[#3b2920] font-medium hover:bg-[#f1dfd1] transition"
                >
                    Explore Collection
                    <i class="ri-arrow-right-line ml-2"></i>
                </a>

            </div>

        </div>

    </section>


    <!-- ========================= -->
    <!-- SHOP CONTENT -->
    <!-- ========================= -->

    <div class="px-10 pb-20 flex gap-10">


        <!-- ========================= -->
        <!-- SIDEBAR -->
        <!-- ========================= -->

        <aside class="w-[20%] hidden lg:block">

            <div class="sticky top-6">

                <p
                    class="text-xs uppercase tracking-[0.2em] text-gray-400 mb-4"
                >
                    Shop
                </p>


                <div class="flex flex-col gap-3">

                    <a
                        href="/shop"
                        class="text-gray-900 font-medium hover:text-[#9a6b4f] transition"
                    >
                        All Products
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        New Collection
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        Best Sellers
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        Travel Bags
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        Backpacks
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        Tote Bags
                    </a>

                </div>


                <!-- DIVIDER -->

                <div class="w-full h-px bg-gray-200 my-8"></div>


                <!-- FILTER -->

                <p
                    class="text-xs uppercase tracking-[0.2em] text-gray-400 mb-4"
                >
                    Filter
                </p>

                <div class="flex flex-col gap-3">

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        Availability
                    </a>

                    <a
                        href="/shop"
                        class="text-gray-500 hover:text-[#9a6b4f] transition"
                    >
                        On Sale
                    </a>

                </div>

            </div>

        </aside>


        <!-- ========================= -->
        <!-- PRODUCTS -->
        <!-- ========================= -->

        <main
            id="products"
            class="w-full lg:w-[80%]"
        >


            <!-- TOP BAR -->

            <div
                class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-8"
            >

                <div>

                    <p class="text-sm text-gray-400">
                        Our collection
                    </p>

                    <h2 class="text-2xl font-semibold text-[#27221f]">
                        Explore our bags
                    </h2>

                </div>


                <!-- SORT -->

                <form
                    action="/shop"
                    method="GET"
                    class="flex items-center gap-3"
                >

                    <label class="text-sm text-gray-500">
                        Sort by
                    </label>

                    <select
                        name="sortby"
                        onchange="this.form.submit()"
                        class="border border-gray-200 bg-white rounded-full px-4 py-2 outline-none text-sm cursor-pointer"
                    >

                        <option value="newest">
                            Newest
                        </option>

                        <option value="popular">
                            Popular
                        </option>

                    </select>

                </form>

            </div>


            <!-- ========================= -->
            <!-- PRODUCT GRID -->
            <!-- ========================= -->

            <div
                class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-6"
            >

                <% if (products && products.length > 0) { %>


                    <% products.forEach(function(product) { %>


                        <!-- PRODUCT CARD -->

                        <div
                            class="group rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-sm hover:shadow-xl transition duration-300"
                        >


                            <!-- IMAGE -->

                            <div
                                class="relative h-72 flex items-center justify-center overflow-hidden"
                                style="background-color: <%= product.bgcolor %>;"
                            >

                                <!-- SALE BADGE -->

                                <% if (product.discount && Number(product.discount) > 0) { %>

                                    <div
                                        class="absolute top-4 left-4 z-10 px-3 py-1 rounded-full bg-[#2f5d50] text-white text-xs font-medium"
                                    >
                                        SALE
                                    </div>

                                <% } %>


                                <!-- ADD BUTTON -->

                                <form
                                    action="/cart/add/<%= product._id %>"
                                    method="POST"
                                    class="absolute top-4 right-4 z-10"
                                >

                                    <button
                                        type="submit"
                                        title="Add to cart"
                                        class="w-11 h-11 rounded-full bg-white shadow-md flex items-center justify-center text-gray-800 hover:bg-[#2f5d50] hover:text-white transition"
                                    >

                                        <i class="ri-shopping-bag-3-line text-lg"></i>

                                    </button>

                                </form>


                                <!-- PRODUCT IMAGE -->

                                <% if (product.image) { %>

                                    <img
                                        class="h-[15rem] max-w-[90%] object-contain group-hover:scale-105 transition duration-500"
                                        src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                        alt="<%= product.name %>"
                                    >

                                <% } else { %>

                                    <div class="text-gray-400">
                                        No Image
                                    </div>

                                <% } %>

                            </div>


                            <!-- PRODUCT DETAILS -->

                            <div
                                class="px-5 py-5"
                                style="
                                    background-color: <%= product.panelcolor || '#ffffff' %>;
                                    color: <%= product.textcolor || '#222222' %>;
                                "
                            >

                                <div class="flex justify-between items-start gap-4">

                                    <div>

                                        <p
                                            class="text-xs uppercase tracking-wider opacity-60 mb-1"
                                        >
                                            Premium Collection
                                        </p>

                                        <h3 class="text-lg font-semibold">
                                            <%= product.name %>
                                        </h3>

                                        <div class="flex items-center gap-2 mt-2">

                                            <span class="font-medium">
                                                ₹ <%= Number(product.price).toFixed(0) %>
                                            </span>


                                            <% if (product.discount && Number(product.discount) > 0) { %>

                                                <span class="text-sm opacity-50 line-through">
                                                    ₹ <%= (Number(product.price) + Number(product.discount)).toFixed(0) %>
                                                </span>

                                            <% } %>

                                        </div>

                                    </div>


                                    <!-- SMALL ADD BUTTON -->

                                    <form
                                        action="/cart/add/<%= product._id %>"
                                        method="POST"
                                    >

                                        <button
                                            type="submit"
                                            class="w-9 h-9 rounded-full bg-white/80 hover:bg-white flex items-center justify-center shadow-sm transition"
                                            title="Add to cart"
                                        >

                                            <i class="ri-add-line"></i>

                                        </button>

                                    </form>

                                </div>

                            </div>

                        </div>


                    <% }) %>


                <% } else { %>


                    <!-- NO PRODUCTS -->

                    <div class="col-span-full py-20 text-center">

                        <div
                            class="w-16 h-16 mx-auto rounded-full bg-gray-100 flex items-center justify-center mb-4"
                        >

                            <i class="ri-shopping-bag-line text-2xl text-gray-400"></i>

                        </div>

                        <h3 class="text-xl font-medium">
                            No products available
                        </h3>

                        <p class="text-gray-500 mt-2">
                            Check back soon for our latest collection.
                        </p>

                    </div>


                <% } %>

            </div>

        </main>

    </div>

</div>

<%- include('./partials/footer') %>